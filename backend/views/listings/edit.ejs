<% layout("../layouts/boilerplate") %>

<div class="rows">
    <div class="col-8 offset-2 mt-3">
    <h3> Edit Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" >

        
        <div class="mb-3">
         <label for="title" name="form-label">Title</label>
        <input
         name="listing[title]" 
         required
         class="form-control"
        value="<%=listing.title%>"
         >
    <div class="invalid-feedback">Enter title</div>
        </div>
      
    
      <div class="mb-3">
          <label for="description" name="form-label">Description</label>
        <textarea
         name="listing[description]" 
         required 
         type="string"
         class="form-control"
         ><%= listing.description %></textarea>

         <div class="invalid-feedback">Enter valid description</div>
      </div>

       

       <div class="rows">
         <div class="mb-3 col-md-4">

        <label for="price" name="form-label">Price</label>
        <input name="listing[price]"
       required
        class="form-control"
       value="<%=listing.price%>"
        >
         <div class="invalid-feedback">Enter valid price</div>

         </div>

      <div class="mb-3 col-md-8">
        <label for="country" name="form-label">Country</label>

        <input name="listing[country]"
        required
        class="form-control"
       value="<%=listing.country%>"
         >
          <div class="invalid-feedback">Enter valid country</div>
        </div>
        

        </div>



        <div class="mb-3 col-md-8" >

         <label for="location" name="form-label">Location</label>
        <input name="listing[location]"
        required
        class="form-control"
         value="<%=listing.location%>"
         >

          <div class="invalid-feedback">Enter valid location</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" id="category" class="form-select" required>
            <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
            <option value="Desert" <%= listing.category === "Desert" ? "selected" : "" %>>Desert</option>
            <option value="Beach" <%= listing.category === "Beach" ? "selected" : "" %>>Beach</option>
            <option value="Forests" <%= listing.category === "Forests" ? "selected" : "" %>>Forests</option>
            <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
            <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
            <option value="Lakes" <%= listing.category === "Lakes" ? "selected" : "" %>>Lakes</option>
            <option value="Iconic cities" <%= listing.category === "Iconic cities" ? "selected" : "" %>>Iconic cities</option>
          </select>
          <div class="invalid-feedback">Choose a category</div>
        </div>

        <button class="btn btn-dark">Add</button>
    </form>
    </div>
    </div>
