<% layout("../layouts/boilerplate") %>

<div class="row justify-content-center mt-4 mb-5">
  <div class="col-12 col-lg-8">
    <h3 class="mb-3"><%= listing.title %></h3>

    <div class="card listing-show-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top listing-show-image"
        alt="<%= listing.title %>"
      >
      <div class="card-body listing-show-body">
        <p class="mb-3"><%= listing.description %></p>
        <div class="row g-3 listing-details">
          <div class="col-sm-6">
            <span class="listing-detail-label">Price</span>
            <span>&#8377; <%= listing.price.toLocaleString('en-IN') %> / night</span>
          </div>
          <div class="col-sm-6">
            <span class="listing-detail-label">Location</span>
            <span><%= listing.location %>, <%= listing.country %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2 my-4 listing-actions">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4">Edit listing</a>
      <form method="POST" action="/listings/<%= listing._id %>/delete?_method=DELETE">
        <button type="submit" class="btn btn-outline-danger px-4">Delete listing</button>
      </form>
    </div>

    <section class="review-panel mt-4">
      <h4 class="mb-1">Leave a review</h4>
      <p class="text-muted mb-4">Share a little about your stay.</p>

      <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
        <div class="row g-3">
          <div class="col-md-4">
            <label for="rating" class="form-label">Rating</label>
            <div class="rating-input">
              <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range">
              <div class="d-flex justify-content-between small text-muted">
                <span>1</span><span>5</span>
              </div>
            </div>
          </div>
          <div class="col-12">
            <label for="comment" class="form-label">Comment</label>
            <textarea
              name="review[comment]"
              id="comment"
              class="form-control"
              rows="4"
              placeholder="What did you enjoy about this place?"
              required
            ></textarea>
            <div class="invalid-feedback">Please add a comment for your review.</div>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-dark px-4">Submit review</button>
          </div>
        </div>
      </form>
    </section>
  </div>
</div>
