<% layout("../layouts/boilerplate") %>

    <h3><%=listing.title %></h3>
    
    <div class="card  listing-show-card">

  <img 
  src="<%= listing.image.url%>" 
  class="card-img-top listing-show-image"
  alt="img"
  >

  <div class="card-body">

    <p class="card-text">
        
       <p> <%=listing.description %></p>
        <p>  &#8377 <%=listing.price.toLocaleString('en-IN' ) %> /night </p>
        <p> <%=listing.location%></p>
        <p> <%=listing.country %></p>
      
    </ul>

    </p>
  </div>
</div>

