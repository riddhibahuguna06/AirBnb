<% layout("../layouts/boilerplate") %>
<body>
    
<div class="rows">
    <div class="col-8 offset-2">
    <h3> Create New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" >

        
        <div class="mb-3">
         <label for="title" name="form-label">Title</label>
        <input
         name="listing[title]" 
         required
         class="form-control"
         placeholder="add title"
         >

        </div>
      
    
      <div class="mb-3">
          <label for="description" name="form-label">Description</label>
        <textarea
         name="listing[description]" 
         required 
         type="string"
         class="form-control"
         placeholder="add description"
         ></textarea>
      </div>

       

       <div class="mb-3">
         <label for="image" name="form-label">Image-Link</label>
        <input name="listing[image]" 
        type="number"
        class="form-control"
        placeholder="add image url"
        >

       </div>

       <div class="rows">
         <div class="mb-3 col-md-4">

        <label for="price" name="form-label">Price</label>
        <input name="listing[price]"
       required
        class="form-control"
        placeholder="add price"
        >

         </div>


        <div class="mb-3 col-md-8" >

         <label for="location" name="form-label">Location</label>
        <input name="listing[location]"
        required
        class="form-control"
        placeholder="location"
         >
        </div>

        </div>

        <div class="mb-3">
        <label for="country" name="form-label">Country</label>

        <input name="listing[country]"
        required
        class="form-control"
        placeholder="add country"
         >
        </div>
        
        <button class="btn btn-dark">Add</button>
    </form>
    </div>
    </div>
</body>