<% layout("../layouts/boilerplate") %>

    
<div class="rows">
    <div class="col-8 offset-2 mt-3">
    <h3> Create New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        
        <div class="mb-3">
         <label for="title" name="form-label">Title</label>
        <input
         name="listing[title]" 
         required
         class="form-control"
         placeholder="add title"
         >
    <div class="invalid-feedback">Enter title</div>
        </div>
      
    
      <div class="mb-3">
          <label for="description" name="form-label">Description</label>
        <textarea
         name="listing[description]" 
         required 
         type="string"
         class="form-control"
         placeholder="add description"
         ></textarea>

         <div class="invalid-feedback">Enter valid description</div>
      </div>

       

       <div class="mb-3">
         <label for="image" name="form-label">Upload Listing Image</label>
        <input name="listing[image]" 
        type="file"
        class="form-control"
       
        >

       </div>

       <div class="rows">
         <div class="mb-3 col-md-4">

        <label for="price" name="form-label">Price</label>
        <input name="listing[price]"
       required
        class="form-control"
        placeholder="add price"
        >
         <div class="invalid-feedback">Enter valid price</div>

         </div>
       
        <div class="mb-3 col-md-8">
        <label for="country" name="form-label">Country</label>

        <input name="listing[country]"
        required
        class="form-control"
        placeholder="add country"
         >
          <div class="invalid-feedback">Enter valid country</div>
        </div>


        </div>

         <div class="mb-3" >

         <label for="location" name="form-label">Location</label>
        <input name="listing[location]"
        required
        class="form-control"
        placeholder="location"
         >

          <div class="invalid-feedback">Enter valid location</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" id="category" class="form-select" required>
            <option value="Mountains" selected>Mountains</option>
            <option value="Desert">Desert</option>
            <option value="Beach">Beach</option>
            <option value="Forests">Forests</option>
            <option value="Farms">Farms</option>
            <option value="Camping">Camping</option>
            <option value="Lakes">Lakes</option>
            <option value="Iconic cities">Iconic cities</option>
          </select>
          <div class="invalid-feedback">Choose a category</div>
        </div>
        
        <button class="btn btn-dark">Add</button>
    </form>
    </div>
    </div>
